+.mock .ck i{aspect-ratio:1;border-radius:7px;box-shadow:inset 0 0 0 1.5px var(--ring)}
+.mock .ck i.e{background:var(--cobalt);box-shadow:none}
+.mock .ck i.p{background:repeating-linear-gradient(135deg,transparent 0 4px,rgba(125,132,154,.3) 4px 5px)}
