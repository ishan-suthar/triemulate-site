+/* hero visual */
+.hv{position:relative;height:660px}
+.pcard{position:absolute;left:50%;top:50%;width:min(470px,92%);transform:translate(-50%,-50%) rotate(-1.2deg);background:#fff;border-radius:24px;box-shadow:var(--shadow-l);padding:20px 22px 18px;border:1px solid rgba(214,225,247,.9)}
