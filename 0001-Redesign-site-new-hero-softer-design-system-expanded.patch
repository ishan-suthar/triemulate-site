+.jfallback p{font-size:15px;color:var(--gray-d);margin-top:4px}
+.jstatic #jcanvas,.jstatic .journey,.jstatic .jpanel,.jstatic .jrail,.jstatic .jhead{display:none}
+.jstatic .jfallback{display:block}
+
+/* ================= HOME SECTIONS ================= */
+/* provenance band */
+.prov{padding:90px 0 40px;text-align:center}
+.prov .h2{max-width:14ch;margin:18px auto 0}
+.prov p{margin:18px auto 0;max-width:40em;font-size:18px;color:var(--gray-d)}
+
+/* choose your path */
+.paths{display:grid;grid-template-columns:1fr 1fr;gap:26px}
+.path{position:relative;display:flex;flex-direction:column;padding:38px 36px 34px;border-radius:28px;background:var(--cream);overflow:hidden;transition:transform .25s,box-shadow .25s}
+.path:hover{transform:translateY(-4px);box-shadow:var(--shadow-l)}
+.path.alt{background:var(--jet);color:#fff}
+.path .pi{width:56px;height:56px;border-radius:16px;display:grid;place-items:center;background:#fff;color:var(--cobalt);box-shadow:var(--shadow)}
+.path.alt .pi{background:var(--cobalt);color:#fff;box-shadow:none}
+.path .pi svg{width:26px;height:26px}
+.path h3{margin-top:26px;font-size:28px;font-weight:600;letter-spacing:-.025em;color:var(--cobalt)}
+.path.alt h3{color:#fff}
+.path > p{margin-top:10px;font-size:16px;color:var(--gray-d);max-width:30em}
+.path.alt > p{color:#B9C2D6}
+.path ul{list-style:none;margin:26px 0 30px;display:grid;gap:13px}
+.path li{display:grid;grid-template-columns:22px 1fr;gap:12px;font-size:15.5px;line-height:1.45}
+.path li svg{width:18px;height:18px;color:var(--cobalt);margin-top:2px}
+.path.alt li svg{color:var(--sky)}
+.path .btn{margin-top:auto;align-self:flex-start}
+.path::after{content:"";position:absolute;right:-70px;top:-70px;width:220px;height:220px;border-radius:50%;background:radial-gradient(closest-side,rgba(79,134,232,.22),transparent);pointer-events:none}
+
+/* why cards */
+.why{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
+.wcard{padding:34px 30px 32px;border-radius:var(--radius);background:#fff;border:1px solid var(--rule);text-align:center;transition:box-shadow .25s,transform .25s}
+.wcard:hover{box-shadow:var(--shadow-l);transform:translateY(-3px)}
+.wart{width:150px;height:120px;margin:0 auto 22px}
+.wcard h3{font-size:22px;font-weight:600;letter-spacing:-.02em;color:var(--cobalt)}
+.wcard p{margin-top:12px;font-size:15.5px;color:var(--gray-d)}
+
+/* steps */
+.steps{position:relative;display:grid;gap:90px}
+.steps::before{content:"";position:absolute;left:50%;top:30px;bottom:30px;width:2px;margin-left:-1px;background:repeating-linear-gradient(180deg,var(--ring) 0 8px,transparent 8px 16px)}
+.step{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:120px;align-items:center}
+.step .num{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:64px;height:64px;border-radius:50%;display:grid;place-items:center;background:var(--cobalt);color:#fff;font-size:22px;font-weight:600;box-shadow:0 0 0 10px var(--mist),0 0 0 11px var(--ring);z-index:2}
+.step .txt .lab{font:700 12px/1 "JetBrains Mono",monospace;letter-spacing:.14em;color:var(--gray-m)}
+.step .txt h3{margin-top:12px;font-size:clamp(26px,2.6vw,34px);font-weight:600;letter-spacing:-.03em;line-height:1.12}
+.step .txt p{margin-top:14px;font-size:17px;color:var(--gray-d)}
+.step.flip .txt{order:2}
+.mock{padding:22px;border-radius:var(--radius);background:#fff;box-shadow:var(--shadow-l);border:1px solid rgba(214,225,247,.9)}
+.mock .ml{font:700 10.5px/1 "JetBrains Mono",monospace;letter-spacing:.14em;color:var(--gray-m);text-transform:uppercase}
+.mock .inp{margin-top:10px;padding:14px 16px;border-radius:14px;background:var(--cream);font-size:15px;line-height:1.45}
+.mock .inp .cur{display:inline-block;width:2px;height:1.05em;background:var(--cobalt);vertical-align:-2px;margin-left:2px;animation:blink 1s steps(1) infinite}
+@keyframes blink{50%{opacity:0}}
+.mock .pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
+.mock .pills span{padding:8px 12px;border-radius:99px;background:var(--mist);color:var(--cobalt);font-size:13px;font-weight:500}
