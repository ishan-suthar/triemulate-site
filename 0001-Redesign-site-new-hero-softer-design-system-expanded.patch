+.pc-top .tag{margin-left:auto;padding:4px 10px;border-radius:99px;background:var(--mist);color:var(--cobalt);font-weight:600;font-size:11px}
+.pc-q{margin-top:14px;font-size:15px;font-weight:600;line-height:1.38;letter-spacing:-.01em}
+.pc-tl{margin:16px 0 4px;padding:14px 14px 12px;border-radius:14px;background:var(--cream)}
+.pc-tl svg{width:100%;height:auto}
+.pc-rows{margin-top:12px;border-top:1px solid var(--rule)}
+.pc-row{display:grid;grid-template-columns:22px 1fr 1.25fr 16px;gap:10px;align-items:center;padding:9px 0;border-bottom:1px solid var(--rule);font-size:12.5px}
+.pc-row .ix{font:700 11px/1 "JetBrains Mono",monospace;color:var(--gray-m)}
+.pc-row .k{font-weight:600}
+.pc-row .v{color:var(--gray-d)}
+.pc-row .st{width:10px;height:10px;border-radius:50%;background:var(--cobalt)}
+.pc-row .st.open{background:transparent;box-shadow:inset 0 0 0 2px var(--amber)}
+.pc-foot{display:flex;justify-content:space-between;margin-top:12px;font-size:11.5px;color:var(--gray-m)}
+.pc-foot b{color:var(--cobalt);font-weight:600}
+
+.chip{position:absolute;display:inline-flex;align-items:center;gap:8px;padding:9px 15px 9px 10px;border-radius:999px;background:rgba(255,255,255,.92);box-shadow:var(--shadow);border:1px solid rgba(214,225,247,.9);font-size:13px;font-weight:500;white-space:nowrap;animation:float 7s ease-in-out infinite}
+.chip .ic{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;background:var(--mist);color:var(--cobalt);flex:none}
+.chip .ic svg{width:13px;height:13px}
+.chip.warn .ic{background:var(--amber-bg);color:var(--amber)}
+.chip b{font-weight:600;color:var(--cobalt)}
+.chip.warn b{color:var(--amber)}
+.c1{left:0;top:1%;animation-delay:-1s}
+.c3{left:47%;top:5%;animation-delay:-5s}
+.c2{right:0;top:0;animation-delay:-3s}
+.c4{right:-9%;top:73%;animation-delay:-2s}
+.c5{left:2%;bottom:1%;animation-delay:-4s}
+.c6{right:2%;bottom:3%;animation-delay:-6s}
+@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
+.dagmini{position:absolute;right:4%;top:20%;width:150px;padding:10px;border-radius:16px;background:#fff;box-shadow:var(--shadow);border:1px solid rgba(214,225,247,.9);animation:float 8s ease-in-out infinite;animation-delay:-2.5s;display:none}
+
+/* hero entrance (html.jin is set before first paint; site.js adds .jgo) */
+.jin .rv{opacity:0;transform:translateY(14px);animation:rvfail 0s linear 2.5s forwards}
+@keyframes rvfail{to{opacity:1;transform:none}}
+.jin.jgo .rv{animation:none;opacity:1;transform:none;transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
+.jin.jgo .rv.d1{transition-delay:.08s}.jin.jgo .rv.d2{transition-delay:.2s}.jin.jgo .rv.d3{transition-delay:.34s}.jin.jgo .rv.d4{transition-delay:.48s}.jin.jgo .rv.d5{transition-delay:.62s}
+
+/* ================= 3D JOURNEY (kept) ================= */
+#jcanvas{position:fixed;inset:0;width:100%;height:100%;display:block;z-index:0}
+.jhead{position:relative;z-index:2;min-height:78vh;display:flex;align-items:center;pointer-events:none}
+.jhead .wrap{width:100%}
+.jhead .box{max-width:500px}
+.jhead h2{font-size:clamp(34px,4.4vw,56px);font-weight:600;line-height:1.05;letter-spacing:-.035em;margin-top:20px}
+.jhead h2 span{color:var(--cobalt)}
+.jhead p{margin-top:18px;font-size:18px;color:var(--gray-d);max-width:30em}
+.jcue{margin-top:30px;font-size:14px;font-weight:500;color:var(--gray-m);display:flex;align-items:center;gap:12px}
+.jcue i{display:inline-block;width:22px;height:36px;border-radius:12px;box-shadow:inset 0 0 0 1.5px var(--gray-m);position:relative}
+.jcue i::after{content:"";position:absolute;left:50%;top:7px;width:3px;height:7px;margin-left:-1.5px;border-radius:2px;background:var(--cobalt);animation:wheel 1.6s ease-in-out infinite}
+@keyframes wheel{60%{transform:translateY(10px);opacity:0}100%{opacity:0}}
+.journey{height:900vh;position:relative;z-index:1}
+
+.jpanel{position:fixed;z-index:15;left:var(--pad);bottom:calc(var(--pad) + env(safe-area-inset-bottom,0px));width:min(430px,calc(100vw - 2*var(--pad) - 44px));background:rgba(255,255,255,.86);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(214,225,247,.9);border-radius:var(--radius);box-shadow:var(--shadow-l);padding:20px 22px 22px;opacity:0;transform:translateY(10px);transition:opacity .3s,transform .3s;pointer-events:none}
+.jpanel.on{opacity:1;transform:none}
+.jphead{display:flex;align-items:baseline;gap:12px;padding-bottom:12px;border-bottom:1px solid var(--rule)}
+.jpix{font:700 12px/1 "JetBrains Mono",monospace;color:var(--cobalt);background:var(--mist);padding:6px 10px;border-radius:99px}
+.jpname{font-size:clamp(24px,2.8vw,34px);font-weight:600;letter-spacing:-.03em;line-height:1}
+.jptext{margin-top:12px;font-size:15px;line-height:1.5;color:var(--gray-d);min-height:4.5em}
+.jpdec{margin-top:12px;font-size:13.5px;line-height:1.45}
+.jpdec b{font-weight:600;color:var(--cobalt)}
+
+.jrail{position:fixed;z-index:15;right:var(--pad);top:55%;transform:translateY(-50%);display:flex;flex-direction:column;gap:14px;opacity:0;transition:opacity .3s;pointer-events:none}
+.jrail.on{opacity:1;pointer-events:auto}
+.jrail button{all:unset;cursor:pointer;display:flex;align-items:center;gap:10px;justify-content:flex-end;font-size:12.5px;font-weight:500;color:var(--gray-m)}
+.jrail button span{opacity:0;transition:opacity .25s;background:rgba(255,255,255,.9);padding:3px 9px;border-radius:99px}
+.jrail button:hover span,.jrail button:focus-visible span,.jrail button.cur span{opacity:1}
+.jrail button i{display:block;width:10px;height:10px;border-radius:50%;box-shadow:inset 0 0 0 1.5px var(--gray-m);transition:all .25s}
+.jrail button.done i{background:var(--gray-m)}
+.jrail button.cur i{background:var(--cobalt);box-shadow:0 0 0 4px rgba(19,81,170,.18);width:12px;height:12px}
+.jrail button.cur{color:var(--jet)}
+
+.jsolid{position:relative;z-index:3;background:var(--paper)}
+.jfallback{display:none;position:relative;z-index:3;background:var(--cream);padding:90px 0}
+.jfallback ol{list-style:none;display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
+.jfallback li{display:grid;grid-template-columns:44px 1fr;gap:12px;padding:20px;border-radius:var(--radius-s);background:#fff;box-shadow:var(--shadow)}
